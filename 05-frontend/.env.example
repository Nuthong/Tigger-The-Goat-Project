# Copy to .env.local for local dev. .env* is gitignored (except this file).

# Where the SPA sends API calls. In dev, leave as /api/v1 and let Vite proxy it
# to the FastAPI server (see vite.config.ts). In prod, set the full origin.
VITE_API_BASE=/api/v1

# Dev-only: the FastAPI origin Vite proxies /api to.
VITE_API_TARGET=http://localhost:8000
