# คัดลอกเป็น .env แล้วแก้ค่า — .env อยู่ใน .gitignore ห้าม commit
# ---------------------------------------------------------------------

# PostgreSQL — ใช้ role least-privilege (app_rw) ไม่ใช่ superuser  (ดู 03-database/roles.sql)
DATABASE_URL=postgresql+psycopg://app_rw:CHANGE_ME_rw@localhost:5432/roombooking

# JWT — สร้าง secret ใหม่ด้วย:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# CORS — origin ของ React (คั่นด้วย comma) ห้ามใส่ "*"
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# นโยบายล็อกบัญชี
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# rate limit ต่อ IP สำหรับ endpoint auth
AUTH_RATE_LIMIT=5/minute
# /auth/refresh มี bucket แยก (เปิดหน้า/แท็บใหม่ = refresh 1 ครั้ง)
REFRESH_RATE_LIMIT=60/minute

# สภาพแวดล้อม: local | production  (production จะบังคับ Secure cookie + HSTS)
ENVIRONMENT=local
LOG_LEVEL=INFO
