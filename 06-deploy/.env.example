# Copy to .env (gitignored) to override the local-demo defaults baked into
# docker-compose.yml. Leaving .env absent is fine - `docker compose up` still
# works out of the box with the same values this project has always used.
#
# cp .env.example .env

# Postgres superuser password (container: db)
POSTGRES_PASSWORD=postgres

# Least-privilege app roles created by 03-database/roles.sql.
# load-db.sh aligns the DB password with these on every ./load-db.sh run.
APP_RW_PASSWORD=app_rw_pw
APP_RO_PASSWORD=app_ro_pw

# HS256 signing secret for the API's JWTs. Generate a real one for anything
# beyond a local demo: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=local-demo-secret-change-me-0123456789abcdef0123

# Origin allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:8081

LOG_LEVEL=INFO
